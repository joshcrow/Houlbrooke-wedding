# Set automatically by Vercel when you create a Blob store (Storage tab).
BLOB_READ_WRITE_TOKEN=

# Your live URL, e.g. https://houlbrooke-wedding.vercel.app
# Add in Vercel → Settings → Environment Variables, then redeploy.
NEXT_PUBLIC_SITE_URL=

# Secret passcode for the owner page (/manage): lets the couple download
# everything as a zip and remove any photo. Pick something only they know.
OWNER_PASSCODE=

# ---- Optional: auto-backup to Google Drive (the /api/cron/backup job) --------
# Leave all of these blank to disable backup entirely — the job no-ops safely.
# Any random string; secures the cron endpoint.
CRON_SECRET=
# From a one-time Google OAuth (see HANDOFF.md). Scope: drive.file.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# The Drive folder to back up into (the long id from its URL).
GDRIVE_FOLDER_ID=
